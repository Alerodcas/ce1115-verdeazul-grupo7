# Copiar a .env para desarrollo LOCAL. .env está en .gitignore.
# En Cloud Run nada de esto se usa: los valores vienen de Secret Manager.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=solo-para-desarrollo-no-usar-en-la-nube
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Base local de compose. Para probar contra Neon, pegar aquí la cadena de la
# RAMA DE DESARROLLO de Neon, nunca la de producción.
DATABASE_URL=postgresql://verdeazul:verdeazul@db:5432/verdeazul

OPA_URL=http://opa:8181
