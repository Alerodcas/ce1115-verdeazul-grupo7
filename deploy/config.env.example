# Copiar a deploy/config.env y completar. config.env está en .gitignore.
# NO poner secretos aquí: solo identificadores. Los secretos viven en
# Secret Manager y nunca salen de ahí.

PROJECT_ID=verdeazul-ce1115
REGION=us-central1
SERVICE_NAME=verdeazul
AR_REPO=verdeazul

# Cuenta de servicio con la que CORRE el servicio en Cloud Run.
RUNTIME_SA=verdeazul-run@verdeazul-ce1115.iam.gserviceaccount.com

# Cuenta de servicio que usa GitHub Actions para construir y desplegar.
DEPLOY_SA=verdeazul-deploy@verdeazul-ce1115.iam.gserviceaccount.com

# Se completa después del primer despliegue, con la URL que asigna Cloud Run
# (sin https://). Ejemplo: verdeazul-abc123-uc.a.run.app
PUBLIC_HOST=
